# AuraCare Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Uses persistent SQLite locally, easily switchable to PostgreSQL)
DATABASE_URL=file:./data/auracare.sqlite
# For production PostgreSQL: postgres://user:password@hostname:5432/auracaredb

# Security Secrets
JWT_SECRET=auracare_super_secret_jwt_key_hackathon_2026_x_catalyst

# Google Gemini API Key (Optional for AI Health Companion & Drug Interaction features)
GEMINI_API_KEY=

# Email / SMTP Configuration (Optional - platform includes interactive live preview if SMTP is unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AuraCare Health Alerts <alerts@auracare.health>"

# Proactive Reminder Scheduler Interval in Minutes (default: 5)
REMINDER_INTERVAL_MINUTES=5
